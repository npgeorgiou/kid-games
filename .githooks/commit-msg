#!/usr/bin/env python3
# Commit gate (owner 21 Nov: rules are enforced, not remembered). Enable once per clone: git config core.hooksPath .githooks
# A commit that changes a game's code (anything in games/<game>/ but its .md files and owner-shots) must name its flows in the message:
#   Flow: <game> <flow> [<flow> ...]
# Each named flow must FAIL on the code before the change (the last commit, with the new flows file) and PASS on the code being committed.
import subprocess, sys, re, os, tempfile, shutil
msg = open(sys.argv[1], encoding='utf-8').read()
files = subprocess.run(['git', 'diff', '--cached', '--name-only'], capture_output=True, text=True).stdout.split()
games = sorted({f.split('/')[1] for f in files if f.startswith('games/') and not f.endswith('.md') and '/owner-shots/' not in f and f.count('/') >= 2})
if not games: sys.exit(0)
named = {}
for g, rest in re.findall(r'^Flow:\s*(\S+)\s+(.+)$', msg, re.M): named.setdefault(g, []).extend(rest.split())
missing = [g for g in games if g not in named]
if missing: sys.exit('commit refused: code of %s changed, but no "Flow: <game> <flow>" line names the flow that failed before and passes now' % ', '.join(missing))
root = subprocess.run(['git', 'rev-parse', '--show-toplevel'], capture_output=True, text=True).stdout.strip()
def run(gamedir, flow):  # True when the flow printed PASS and no FAIL
    out = subprocess.run([sys.executable, os.path.join(gamedir, 'tools', 'harness.py'), 'flows', flow], capture_output=True, text=True, cwd=gamedir, timeout=600).stdout
    lines = [l for l in out.splitlines() if l.startswith(('PASS', 'FAIL'))]
    return bool(lines) and all(l.startswith('PASS') for l in lines), out.strip()[-400:]
bad = []
for g in games:
    old = tempfile.mkdtemp()
    subprocess.run('git archive HEAD games/%s | tar -x -C %s' % (g, old), shell=True, check=True, cwd=root)
    shutil.copy(os.path.join(root, 'games', g, 'tools', 'flows.py'), os.path.join(old, 'games', g, 'tools', 'flows.py'))
    for f in named[g]:
        ok_new, out_new = run(os.path.join(root, 'games', g), f)
        ok_old, out_old = run(os.path.join(old, 'games', g), f)
        if not ok_new: bad.append('%s %s does not pass on the new code:\n%s' % (g, f, out_new))
        if ok_old: bad.append('%s %s already passed before the change, so it does not prove the change' % (g, f))
    shutil.rmtree(old, ignore_errors=True)
if bad: sys.exit('commit refused:\n' + '\n'.join(bad))
