#!/usr/bin/env python3
# Commit gate (owner 21 Nov: rules are enforced, not remembered). Enable once per clone: git config core.hooksPath .githooks
# Games listed in strict-games.txt are checked by game_checks.py (owner 24 Nov). Any other game whose code changes (its .html page, src/ or lib/) must name its flows in the message:
#   Flow: <game> <flow> [<flow> ...]
# Each named flow must PASS on the code being committed.
import subprocess, sys, re, os, tempfile, shutil
msg = open(sys.argv[1], encoding='utf-8').read()
files = subprocess.run(['git', 'diff', '--cached', '--name-only'], capture_output=True, text=True).stdout.split()
root = subprocess.run(['git', 'rev-parse', '--show-toplevel'], capture_output=True, text=True).stdout.strip()
renamed = {}  # a game folder renamed in this commit: new name -> old name, so the old name is not checked as a game
for l in subprocess.run(['git', 'diff', '--cached', '-M', '--name-status'], capture_output=True, text=True).stdout.splitlines():
    p = l.split('\t')
    if p[0].startswith('R') and p[1].startswith('games/') and p[2].startswith('games/') and p[1].split('/')[1] != p[2].split('/')[1]: renamed[p[2].split('/')[1]] = p[1].split('/')[1]
games = sorted({f.split('/')[1] for f in files if f.startswith('games/') and f.count('/') >= 2 and (f.endswith('.html') or '/src/' in f or '/lib/' in f)} - set(renamed.values()))  # the game itself: its page, its source, its libraries (not tests, tools or notes)
for f in files:  # owner 23 Nov 20:11: a README's "Now" says what the game is now: never a list of what was done, never dates (history lives in git)
    if not re.match(r'games/[^/]+/README\.md$', f): continue
    txt = subprocess.run(['git', 'show', ':' + f], capture_output=True, text=True).stdout
    m = re.search(r'^## Now\s*$(.*?)(?=^## |\Z)', txt, re.M | re.S)
    if not m: continue
    hits = re.findall(r'\b(?:done|fixed|finished|added|batch \d+|\d{1,2} (?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*|(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]* \d{1,2}|\d{4}-\d{2}-\d{2})\b', m.group(1), re.I)
    if hits: sys.exit('commit refused: %s "Now" reads like a log (%s); say what the game is now, no done lists or dates' % (f, ', '.join(sorted(set(hits))[:5])))
if not games: sys.exit(0)
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import game_checks  # games on the strict rules: test first, no back-door moves, the whole test set within 20 s (owner 24 Nov)
strict = [g for g in games if g in game_checks.strict_games()]
games = [g for g in games if g not in strict]
problems = []
for g in strict:
    f = 'games/%s/tools/flows.py' % g
    old = subprocess.run(['git', 'show', 'HEAD:' + f], capture_output=True, text=True).stdout
    new = subprocess.run(['git', 'show', ':' + f], capture_output=True, text=True).stdout
    problems += game_checks.check(os.path.join(root, 'games', g), old, new, True, root)
if problems: sys.exit('commit refused:\n' + '\n'.join(problems))
if not games: sys.exit(0)
named = {}
for g, rest in re.findall(r'^Flow:\s*(\S+)\s+(.+)$', msg, re.M): named.setdefault(g, []).extend(rest.split())
missing = [g for g in games if g not in named]
if missing: sys.exit('commit refused: code of %s changed, but no "Flow: <game> <flow>" line names the flow of this change' % ', '.join(missing))
def run(gamedir, flow):  # (passed, tail): passed when it printed PASS lines and no FAIL (a run that never started proves nothing)
    env = dict(os.environ, TMPDIR=tempfile.mkdtemp(), GIT_DIR=os.path.join(root, '.git'))  # own temp files; GIT_DIR so a harness outside the repo still sees the gate is on
    out = subprocess.run([sys.executable, os.path.join(gamedir, 'tools', 'harness.py'), 'flows', flow], capture_output=True, text=True, cwd=gamedir, timeout=600, env=env).stdout
    lines = [l for l in out.splitlines() if l.startswith(('PASS', 'FAIL'))]
    shutil.rmtree(env['TMPDIR'], ignore_errors=True)
    return bool(lines) and all(l.startswith('PASS') for l in lines), out.strip()[-400:]
def run_all(gamedir, flows):  # one harness run for all the flows: a harness that tags its lines "PASS [flow] ..." gives each flow its verdict; any other runs one flow at a time
    env = dict(os.environ, TMPDIR=tempfile.mkdtemp(), GIT_DIR=os.path.join(root, '.git'))
    out = subprocess.run([sys.executable, os.path.join(gamedir, 'tools', 'harness.py'), 'flows'] + flows, capture_output=True, text=True, cwd=gamedir, timeout=600, env=env).stdout
    shutil.rmtree(env['TMPDIR'], ignore_errors=True)
    seen = {}
    for l in out.splitlines():
        m = re.match(r'(PASS|FAIL)\s+\[(\S+)\]', l)
        if m: seen.setdefault(m.group(2), []).append(m.group(1))
    if all(f in seen for f in flows): return {f: (all(v == 'PASS' for v in seen[f]), '\n'.join(l for l in out.splitlines() if '[%s]' % f in l)) for f in flows}
    return {f: run(gamedir, f) for f in flows}
bad = []
for g in games:
    for f, (ok, out) in run_all(os.path.join(root, 'games', g), named[g]).items():
        if not ok: bad.append('%s %s does not pass:\n%s' % (g, f, out))
if bad: sys.exit('commit refused:\n' + '\n'.join(bad))
