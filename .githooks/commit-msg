#!/usr/bin/env python3
# Commit gate (owner 21 Nov: rules are enforced, not remembered). Enable once per clone: git config core.hooksPath .githooks
# A commit that changes a game (its .html page, src/ or lib/) must name its flows in the message:
#   Flow: <game> <flow> [<flow> ...]
# Each named flow must FAIL on the code before the change (the last commit, with the new flows file) and PASS on the code being committed.
import subprocess, sys, re, os, tempfile, shutil
from concurrent.futures import ThreadPoolExecutor
msg = open(sys.argv[1], encoding='utf-8').read()
files = subprocess.run(['git', 'diff', '--cached', '--name-only'], capture_output=True, text=True).stdout.split()
games = sorted({f.split('/')[1] for f in files if f.startswith('games/') and f.count('/') >= 2 and (f.endswith('.html') or '/src/' in f or '/lib/' in f)})  # the game itself: its page, its source, its libraries (not tests, tools or notes)
if not games: sys.exit(0)
named = {}
for g, rest in re.findall(r'^Flow:\s*(\S+)\s+(.+)$', msg, re.M): named.setdefault(g, []).extend(rest.split())
missing = [g for g in games if g not in named]
if missing: sys.exit('commit refused: code of %s changed, but no "Flow: <game> <flow>" line names the flow that failed before and passes now' % ', '.join(missing))
root = subprocess.run(['git', 'rev-parse', '--show-toplevel'], capture_output=True, text=True).stdout.strip()
def run(gamedir, flow):  # (passed, failed, tail): passed when it printed PASS lines and no FAIL; failed only when it printed a FAIL line (a run that never started proves nothing)
    env = dict(os.environ, TMPDIR=tempfile.mkdtemp(), GIT_DIR=os.path.join(root, '.git'))  # own temp files, so old and new run at once; GIT_DIR so a harness outside the repo still sees the gate is on
    out = subprocess.run([sys.executable, os.path.join(gamedir, 'tools', 'harness.py'), 'flows', flow], capture_output=True, text=True, cwd=gamedir, timeout=600, env=env).stdout
    lines = [l for l in out.splitlines() if l.startswith(('PASS', 'FAIL'))]
    shutil.rmtree(env['TMPDIR'], ignore_errors=True)
    return bool(lines) and all(l.startswith('PASS') for l in lines), any(l.startswith('FAIL') for l in lines), out.strip()[-400:]
bad = []
for g in games:
    old = tempfile.mkdtemp()
    subprocess.run('git archive HEAD games/%s | tar -x -C %s' % (g, old), shell=True, check=True, cwd=root)
    shutil.copy(os.path.join(root, 'games', g, 'tools', 'flows.py'), os.path.join(old, 'games', g, 'tools', 'flows.py'))
    for f in named[g]:
        with ThreadPoolExecutor(2) as ex:  # owner 21 Nov: the old and the new code run at the same time
            new, prev = ex.submit(run, os.path.join(root, 'games', g), f), ex.submit(run, os.path.join(old, 'games', g), f)
            (ok_new, _, out_new), (_, failed_old, out_old) = new.result(), prev.result()
        if not ok_new: bad.append('%s %s does not pass on the new code:\n%s' % (g, f, out_new))
        if not failed_old: bad.append('%s %s did not fail on the code before the change, so it does not prove the change:\n%s' % (g, f, out_old))
    shutil.rmtree(old, ignore_errors=True)
if bad: sys.exit('commit refused:\n' + '\n'.join(bad))
